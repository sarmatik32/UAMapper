{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/deepstatemap/occupied",
      "destination": "/api/deepstatemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/deepstatemap.ts": {
      "includeFiles": "public/data/deepstate/latest.geojson"
    }
  }
}
